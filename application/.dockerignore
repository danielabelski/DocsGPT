# Build context is application/. Keep local state and caches out of the image.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
*.log

# Runtime data: bind-mounted or created at run time, never baked in.
indexes/
inputs/
vectors/
*.faiss
*.pkl

# Secrets and local config.
.env
.env.*

# Not needed inside the image.
Dockerfile
.dockerignore
